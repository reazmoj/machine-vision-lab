#dataManagementInterface {
    background-color: transparent;
}

QPushButton {
    color: white;
    background: rgb(0, 153, 188);
    border: 1px solid rgb(0, 153, 188);
    border-radius: 5px;
    padding: 5px 15px;
    font-size: 14px;
}

QPushButton:hover {
    background: rgb(0, 173, 208);
    border-color: rgb(0, 173, 208);
}

QPushButton:pressed {
    background: rgb(0, 133, 168);
    border-color: rgb(0, 133, 168);
}

QPushButton:disabled {
    background: rgb(120, 120, 120);
    border-color: rgb(120, 120, 120);
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QWidget#image_container {
    background-color: transparent;
}

ImageThumbnail {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 5px;
    padding: 5px;
}

ImageThumbnail:hover {
    background-color: rgba(0, 0, 0, 0.1);
}

QLabel {
    color: black;
}